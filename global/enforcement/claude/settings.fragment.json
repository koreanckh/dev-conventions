{
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(chmod 777:*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume prune:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git worktree remove:*)",
      "Bash(git checkout -- :*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release create:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(psql:*)",
      "Bash(pnpm db:push:*)",
      "Bash(pnpm db:migrate:*)",
      "Bash(supabase db reset:*)",
      "Bash(kubectl delete:*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)"
    ],
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(corepack:*)",
      "Bash(node:*)",
      "Bash(tsc:*)",
      "Bash(node_modules/.bin/tsc:*)",
      "Bash(./node_modules/.bin/tsc:*)",
      "Bash(python3:*)",
      "Bash(uv:*)",
      "Bash(flutter:*)",
      "Bash(dart:*)",
      "Bash(docker:*)",
      "Bash(supabase:*)",
      "Bash(shellcheck:*)",
      "Bash(brew:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ln:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(tee:*)",
      "Bash(perl -pi:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(open:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{DEV_CONVENTIONS_DIR}}/global/enforcement/claude/hooks/pre-tool-use-bash-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
